{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gen",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "main": "./src/server-entry.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gen-db",
      "database_id": "b30aeba6-b01c-4b55-bcff-4f48d35771be",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "gen-documents"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_QUEUE",
        "queue": "gen-document-processing"
      }
    ],
    "consumers": [
      {
        "queue": "gen-document-processing",
        "max_batch_size": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
